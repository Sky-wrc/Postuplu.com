<?xml version="1.0" encoding="utf-8"?>
<!-- Те же картинки для pressed — без серой заливки при нажатии -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:state_pressed="true"
        android:drawable="@drawable/checkbox_custom_checked" />
    <item
        android:state_checked="false"
        android:state_pressed="true"
        android:drawable="@drawable/checkbox_custom_unchecked" />
    <item
        android:state_checked="true"
        android:drawable="@drawable/checkbox_custom_checked" />
    <item android:drawable="@drawable/checkbox_custom_unchecked" />
</selector>
